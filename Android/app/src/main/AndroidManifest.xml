<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Used strictly by CatPhotoStore inside the host SettingsActivity to fetch public cat photos
         from HK Google Cloud Storage. MeowpuutIME never accesses the network. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MeowpuutApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.Meowpuut">

        <activity
            android:name=".app.SettingsActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 第一行字: the first-run guide. Opened by SettingsActivity for a new install, and from its settings. Portrait: the page is a tall one. -->
        <activity
            android:name=".app.OnboardingActivity"
            android:exported="false"
            android:label="@string/onboarding_title"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|fontScale"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <!-- 行旅: what the cats' records add up to. Reads this app's own files only; nothing leaves the phone. -->
        <activity
            android:name=".app.StatsActivity"
            android:exported="false"
            android:label="@string/stats_title" />

        <!-- Pet achievements (82) and Route A cross-platform .mpsync sync hub. -->
        <activity
            android:name=".app.PetHubActivity"
            android:exported="false"
            android:label="@string/pet_hub_title" />

        <!-- The custom-skins page. Its filters name only our own MIME types and file extensions (never */* or
             application/octet-stream); only content:// is read, with a size cap, and a package must still be
             signed by the developer and issued for this phone (plans/custom-skins.md §8.3). The in-app file
             picker is the way in for a file whose sender gave it a generic type. -->
        <activity
            android:name=".app.RedeemActivity"
            android:exported="true"
            android:label="@string/cs_title"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/vnd.meowpuut.skin" />
                <data android:mimeType="application/vnd.meowpuut.skin-revoke" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:host="*" android:pathPattern=".*\\.mpskin" />
                <data android:pathPattern=".*\\.mprevoke" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.meowpuut.skin" />
                <data android:mimeType="application/vnd.meowpuut.skin-revoke" />
            </intent-filter>
        </activity>

        <service
            android:name=".ime.MeowpuutIME"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
