<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="喵撲" android:icon="@drawable/meowpuut_mark" android:allowBackup="false"
        android:theme="@style/MeowpuutTheme">
        <activity android:name=".SetupActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service android:name=".MeowpuutKeyboard" android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/input_method" />
        </service>
    </application>
</manifest>
