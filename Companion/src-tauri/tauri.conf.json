{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "喵撲",
  "mainBinaryName": "meowpuut-companion",
  "version": "0.1.0",
  "identifier": "app.meowpuut.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "喵撲",
        "width": 1000,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Utility",
    "shortDescription": "喵撲的陪伴 App",
    "longDescription": "喵撲 Meowpuut 的陪伴 App：你手下那把鍵盤、行旅、鍵盤衣櫥、爪印本與鍵盤設定。打開才存在，關窗就結束。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
